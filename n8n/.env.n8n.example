# n8n Environment — copy to .env and fill in values
# Run from n8n/ directory: docker compose up -d  (Compose auto-loads ./.env)

# n8n internal Postgres password (generate a random string)
N8N_DB_PASSWORD=change-me-to-random-string

# n8n credential encryption key — generate once with `openssl rand -hex 32`, never change after first run
N8N_ENCRYPTION_KEY=change-me-to-random-hex

# Public URL n8n uses for webhook callbacks (your domain or tunnel URL, e.g. https://n8n.example.com/)
# NOTE: the compose file binds n8n to 127.0.0.1 only. External webhook/email
# ingestion (build plan Step 4) needs a tunnel or reverse proxy in front — set
# this to that public URL once you have one.
WEBHOOK_URL=http://localhost:5678/

# Supabase connection (copy from root .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OCR.space free API key (https://ocr.space/ocrapi) — also stored as the
# "OCR.space API Key" httpHeaderAuth credential inside n8n (header name: apikey)
OCR_SPACE_API_KEY=helloworld

# Slack Incoming Webhook for error-handler notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Invoice Export workflow — Google Sheets + QuickBooks sandbox sync.
# The Google Sheets and QuickBooks credentials themselves live in n8n's
# credential store (OAuth2, set up via the n8n UI — see docs/CURRENT_STATE.md),
# not here. These are just the IDs/names the workflow's nodes reference.
GOOGLE_SHEETS_SPREADSHEET_ID=your-test-spreadsheet-id
QUICKBOOKS_REALM_ID=your-sandbox-company-id
QUICKBOOKS_DEFAULT_EXPENSE_ACCOUNT_NAME=Office Expenses

# Gmail ingestion (build plan Step 4). The Gmail OAuth2 credential itself lives
# in n8n's credential store, set up via the n8n UI — this is only the search
# query the trigger polls with. `has:attachment` is the safe default for a
# mailbox dedicated to invoices; narrow it if that mailbox receives anything
# else, e.g. "deliveredto:you+invoices@gmail.com has:attachment".
GMAIL_INVOICE_QUERY=has:attachment
