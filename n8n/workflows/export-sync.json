        "jsonBody": "={\n  \"VendorRef\": {\n    \"value\": \"{{ $json.vendorId }}\"\n  },\n  \"Line\": [\n    {\n      \"Amount\": {{ $json.invoice.total }},\n      \"DetailType\": \"AccountBasedExpenseLineDetail\",\n      \"AccountBasedExpenseLineDetail\": {\n        \"AccountRef\": {\n          \"value\": \"{{ $json.accountId }}\"\n        }\n      },\n      \"Description\": {{ JSON.stringify(($json.invoice.category || 'Uncategorized') + ' \\u2014 ' + ($json.invoice.anomaly_note || '')) }}\n    }\n  ],\n  \"PrivateNote\": {{ JSON.stringify('Auto-synced from Invoice Processor. Category: ' + ($json.invoice.category || 'Uncategorized')) }},\n  \"DocNumber\": {{ JSON.stringify($json.invoice.invoice_number) }}\n}",
