      "typeVersion": 4.2
    },
    {
      "id": "split-invoices-export",
      "name": "Split Invoices",
      "parameters": {
        "jsCode": "// Handle both array and single object (HTTP node auto-splits)\nconst items = $input.all();\nconst invoices = [];\nfor (const item of items) {\n  const json = item.json;\n  if (Array.isArray(json)) {\n    invoices.push(...json);\n  } else {\n    invoices.push(json);\n  }\n}\nif (invoices.length === 0) return [];\nreturn invoices.map(inv => ({ json: inv }));"
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
