        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/invoices?status=in.(auto_approved,reviewed)&or=(sheet_exported_at.is.null,qb_synced_at.is.null)&select=id,vendor_name,invoice_number,invoice_date,total,currency,category,category_confidence,is_recurring,anomaly_note,status,sheet_exported_at,qb_synced_at&limit=1"
      },
