    {
      "id": "match-vendor-ci",
      "name": "Match Vendor (case-insensitive)",
      "parameters": {
        "jsCode": "const invoice = $('Split Invoices').item.json;\nconst vendors = ($json.QueryResponse && $json.QueryResponse.Vendor) || [];\nconst target = (invoice.vendor_name || '').trim().toLowerCase();\nconst match = vendors.find(v => (v.DisplayName || '').trim().toLowerCase() === target);\nconst acctResp = $('Find Expense Account').item.json;\nconst accountId = (acctResp.QueryResponse && acctResp.QueryResponse.Account && acctResp.QueryResponse.Account[0] && acctResp.QueryResponse.Account[0].Id) || null;\nreturn [{ json: { vendorId: match ? match.Id : null, invoice, accountId } }];"
      },
      "position": [
        1890,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
